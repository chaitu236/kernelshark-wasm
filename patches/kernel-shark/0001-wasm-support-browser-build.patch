index 0000000..79fd568
--- /dev/null
+++ b/src/kernelshark.html
@@ -0,0 +1,186 @@
+<!doctype html>
+<html lang="en-us">
+  <head>
+    <meta charset="utf-8">
+    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
+    <meta name="viewport" content="width=device-width, height=device-height, user-scalable=0">
+
+    <title>kernelshark</title>
+    <style>
+      html, body { padding: 0; margin: 0; overflow: hidden; width: 100%; height: 100%; }
+      canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
+      #qtspinner { position: absolute; inset: 0; z-index: 1; margin: 0; }
+      #dropoverlay {
+        position: absolute;
+        inset: 20px;
+        z-index: 2;
+        display: none;
+        place-items: center;
+        border: 3px dashed #1976a3;
+        background: rgba(245, 251, 253, 0.94);
+        color: #143746;
+        font: 600 24px sans-serif;
+        pointer-events: none;
+      }
+      #dropoverlay.visible { display: grid; }
+      #dropoverlay.error { border-color: #b3261e; color: #8c1d18; }
+      #dropcontent { width: min(520px, calc(100% - 48px)); text-align: center; }
+      #dropprogress { width: 100%; height: 18px; margin-top: 18px; accent-color: #1976a3; }
+    </style>
+  </head>
+  <body onload="init()">
+    <figure style="overflow:visible;" id="qtspinner">
+      <center style="margin-top:1.5em; line-height:150%">
+        <strong>Qt for WebAssembly: kernelshark</strong>
+        <div id="qtstatus"></div>
+        <noscript>JavaScript is disabled. Please enable JavaScript to use this application.</noscript>
+      </center>
+    </figure>
+    <canvas id="qtcanvas"></canvas>
+    <div id="dropoverlay" role="status" aria-live="polite">
+      <div id="dropcontent">
+        <div id="dropmessage"></div>
+        <progress id="dropprogress" max="200" hidden></progress>
+      </div>
+    </div>
+
+    <script type="text/javascript">
+      let qtLoader;
+      let activeTracePath;
+      let dropBusy = false;
+      let dropDepth = 0;
+      let dropSequence = 0;
+
+      function setDropOverlay(text, error = false, progress = null) {
+        const overlay = document.querySelector('#dropoverlay');
+        const progressBar = document.querySelector('#dropprogress');
+        document.querySelector('#dropmessage').textContent = text;
+        progressBar.hidden = progress === null;
+        if (progress !== null)
+          progressBar.value = progress;
+        overlay.classList.toggle('error', error);
+        overlay.classList.toggle('visible', Boolean(text));
+      }
+
+      async function loadDroppedTrace(file) {
+        if (dropBusy)
+          return;
+
+        const module = qtLoader && qtLoader.module();
+        if (!module || qtLoader.status !== 'Running') {
+          setDropOverlay('KernelShark is still starting', true);
+          window.setTimeout(() => setDropOverlay(''), 2500);
+          return;
+        }
+
+        dropBusy = true;
+        const safeName = file.name.replace(/[^A-Za-z0-9._-]/g, '_') || 'trace.dat';
+        const path = `/tmp/kernelshark-drop-${++dropSequence}-${safeName}`;
+
+        try {
+          setDropOverlay(`Loading ${file.name}...`, false, 0);
+          module.FS.writeFile(path, new Uint8Array(await file.arrayBuffer()));
+          module.kernelsharkLoadProgress = function(progress) {
+            const percent = Math.round(progress * 100 / 200);
+            setDropOverlay(`Loading ${file.name}... ${percent}%`, false, progress);
+          };
+          module.kernelsharkLoadFinished = function() {
+            if (activeTracePath)
+              module.FS.unlink(activeTracePath);
+            activeTracePath = path;
+            module.kernelsharkLoadProgress = undefined;
+            dropBusy = false;
+            setDropOverlay('');
+          };
+
+          const result = module.ccall(
+            'kernelshark_load_file', 'number', ['string'], [path]);
+          if (result !== 0)
+            throw new Error('KernelShark rejected the file');
+        } catch (error) {
+          module.kernelsharkLoadFinished = undefined;
+          module.kernelsharkLoadProgress = undefined;
+          try {
+            module.FS.unlink(path);
+          } catch (_) {
+          }
+          setDropOverlay(`Unable to load ${file.name}: ${error}`, true);
+          window.setTimeout(() => setDropOverlay(''), 5000);
+          dropBusy = false;
+        }
+      }
+
+      function installDropHandlers() {
+        window.addEventListener('dragenter', event => {
+          event.preventDefault();
+          event.stopImmediatePropagation();
+          ++dropDepth;
+          if (!dropBusy)
+            setDropOverlay('Drop trace file to open');
+        }, true);
+
+        window.addEventListener('dragover', event => {
+          event.preventDefault();
+          event.stopImmediatePropagation();
+          event.dataTransfer.dropEffect = 'copy';
+        }, true);
+
+        window.addEventListener('dragleave', event => {
+          event.preventDefault();
+          event.stopImmediatePropagation();
+          if (--dropDepth <= 0 && !dropBusy) {
+            dropDepth = 0;
+            setDropOverlay('');
+          }
+        }, true);
+
+        window.addEventListener('drop', event => {
+          event.preventDefault();
+          event.stopImmediatePropagation();
+          dropDepth = 0;
+          const file = event.dataTransfer.files[0];
+          if (file)
+            loadDroppedTrace(file);
+          else
+            setDropOverlay('Drop a trace file from your computer', true);
+        }, true);
+      }
+
+      function init() {
+        const spinner = document.querySelector('#qtspinner');
+        const canvas = document.querySelector('#qtcanvas');
+        const status = document.querySelector('#qtstatus');
+
+        installDropHandlers();
+        qtLoader = QtLoader({
+          canvasElements: [canvas],
+          showLoader: function(loaderStatus) {
+            spinner.style.display = 'block';
+            canvas.style.visibility = 'hidden';
+            status.textContent = loaderStatus + '...';
+          },
+          showError: function(errorText) {
+            status.textContent = errorText;
+            spinner.style.display = 'block';
+            canvas.style.visibility = 'hidden';
+          },
+          showExit: function() {
+            status.textContent = 'Application exit';
+            if (qtLoader.exitCode !== undefined)
+              status.textContent += ' with code ' + qtLoader.exitCode;
+            if (qtLoader.exitText !== undefined)
+              status.textContent += ' (' + qtLoader.exitText + ')';
+            spinner.style.display = 'block';
+            canvas.style.visibility = 'hidden';
+          },
+          showCanvas: function() {
+            spinner.style.display = 'none';
+            canvas.style.visibility = 'visible';
+          },
+        });
+        qtLoader.loadEmscriptenModule('kernelshark');
+      }
+    </script>
+    <script type="text/javascript" src="qtloader.js"></script>
+  </body>
+</html>
