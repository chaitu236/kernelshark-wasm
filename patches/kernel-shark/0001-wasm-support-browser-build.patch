+struct kshark_plugin_list *
+kshark_register_static_plugin(struct kshark_context *kshark_ctx,
+			      const struct kshark_plugin_descriptor *descriptor)
+{
+	struct kshark_plugin_list *plugin;
+
+	if (!kshark_ctx || !descriptor || !descriptor->name ||
+	    !descriptor->process_init || !descriptor->process_close)
+		return NULL;
+
+	if (kshark_find_plugin_by_name(kshark_ctx->plugins, descriptor->name))
+		return NULL;
+
+	plugin = calloc(1, sizeof(*plugin));
+	if (!plugin)
+		return NULL;
+
+	plugin->name = strdup(descriptor->name);
+	plugin->file = strdup(descriptor->name);
+	plugin->process_interface = calloc(1, sizeof(*plugin->process_interface));
+	if (!plugin->name || !plugin->file || !plugin->process_interface)
+		goto fail;
+
+	plugin->process_interface->name = strdup(descriptor->name);
+	if (!plugin->process_interface->name)
+		goto fail;
+
+	plugin->process_interface->init = descriptor->process_init;
+	plugin->process_interface->close = descriptor->process_close;
+	plugin->ctrl_interface = descriptor->ctrl_interface;
+	plugin->next = kshark_ctx->plugins;
+	kshark_ctx->plugins = plugin;
+	kshark_ctx->n_plugins++;
+
+	return plugin;
+
+ fail:
+	free_plugin(plugin);
+	return NULL;
+}
