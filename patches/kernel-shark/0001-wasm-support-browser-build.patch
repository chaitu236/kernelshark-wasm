+	 kshark_kvm_combo_plugin_menu_initializer},
+	{"missed_events",
+	 kshark_missed_events_data_plugin_initializer,
+	 kshark_missed_events_data_plugin_deinitializer,
+	 nullptr},
+};
+
+}
+
+void KsBuiltinPlugins::registerPlugins()
+{
+	kshark_context *ksharkCtx(nullptr);
+
+	if (!kshark_instance(&ksharkCtx))
+		return;
+
+	for (const auto &plugin: plugins)
+		kshark_register_static_plugin(ksharkCtx, &plugin);
+}
